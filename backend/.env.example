# 环境配置
ENVIRONMENT=development
DEBUG=true

# 应用配置
APP_NAME=AI Video Maker API
APP_VERSION=1.0.0

# 服务器配置
HOST=0.0.0.0
PORT=8000

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Gemini API（可选）
# GEMINI_API_KEY=

# Unsplash（可选）
# UNSPLASH_ACCESS_KEY=

# MySQL 数据库（必需）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=ai_video_maker
MYSQL_CHARSET=utf8mb4
# 也可直接指定完整 URL（优先于上面的 MYSQL_*）
# DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/ai_video_maker?charset=utf8mb4

# Redis / Celery（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
CELERY_ENABLED=true

# 文件路径
UPLOAD_PATH=data/uploads
OUTPUT_PATH=data/output
TEMP_PATH=data/temp
CACHE_PATH=cache
MAX_FILE_SIZE=104857600

# 视频处理配置
MAX_VIDEO_DURATION=300
DEFAULT_VIDEO_RESOLUTION=720p
DEFAULT_VIDEO_FPS=30
DEFAULT_VIDEO_FORMAT=mp4

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 安全配置（生产环境务必修改）
SECRET_KEY=your-secret-key-please-change-this-in-production
# CORS 支持 JSON 数组或逗号分隔
CORS_ORIGINS=["http://localhost:3000"]

# 云存储配置（可选）
STORAGE_TYPE=local
# STORAGE_TYPE=aliyun_oss
# ALIYUN_ACCESS_KEY=
# ALIYUN_SECRET_KEY=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# ALIYUN_OSS_REGION=oss-cn-hangzhou
